#pragma kernel GenerateHeightmap

// Paramètres du bruit
RWTexture2D<float> HeightmapResult;
float scale;
float2 offset;
int octaves;
float persistence;
float lacunarity;
uint mapSize;
int worldSeed;

// --- FBM/Noise ShaderToy adapté pour Unity compute shader ---
float hash1(float p) { p = frac(p * 0.011); p *= p + 7.5; p *= p + p; return frac(p); }
float hash2(float2 p) { float3 p3 = frac(float3(p.xyx) * 0.13); p3 += dot(p3, p3.yzx + 3.333); return frac((p3.x + p3.y) * p3.z); }

float noise(float2 x) {
    float2 i = floor(x);
    float2 f = frac(x);
    float a = hash2(i);
    float b = hash2(i + float2(1.0, 0.0));
    float c = hash2(i + float2(0.0, 1.0));
    float d = hash2(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float fbm(float2 x, int octaves, float persistence, float lacunarity) {
    float v = 0.0;
    float a = 0.5;
    float2 shift = float2(100.0, 100.0);
    float2 rotX = float2(cos(0.5), sin(0.5));
    float2 rotY = float2(-sin(0.5), cos(0.5));
    float2x2 rot = float2x2(rotX, rotY);
    for (int i = 0; i < octaves; ++i) {
        v += a * noise(x);
        x = mul(rot, x) * lacunarity + shift;
        a *= persistence;
    }
    return v;
}

[numthreads(8,8,1)]
void GenerateHeightmap(uint3 id : SV_DispatchThreadID)
{
    if(id.x >= mapSize || id.y >= mapSize) return;
    float2 worldPos = float2(id.x, id.y) + offset;
    float2 scaledPos = worldPos * scale;
    float height = fbm(scaledPos, octaves, persistence, lacunarity);
    HeightmapResult[id.xy] = height;
}