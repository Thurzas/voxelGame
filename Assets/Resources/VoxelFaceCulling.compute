#pragma kernel CullFaces

// Buffer aplati avec un padding de 1 voxel sur X et Z (pas sur Y : les chunks ne
// s'empilent pas verticalement, cf. Chunk.cs). PaddedIndex(px,py,pz) =
// px + py*PaddedWidth + pz*PaddedWidth*PaddedHeightStride. px=0 et px=PaddedWidth-1
// sont la bordure gauche/droite (voisin de chunk, ou air si non chargé) ; idem pz pour
// Z. Les voxels intérieurs (dont ce chunk est propriétaire) sont à px=1..InnerWidth,
// pz=1..InnerDepth. py va de 0 à InnerHeight-1 et correspond au monde à py+LoY.
StructuredBuffer<uint> Voxels;

// Une face exposée : (x, y, z, packed) en coordonnées locales du chunk (Y déjà "réel",
// pas décalé par LoY). packed = direction (0..5, bits 0-2) | type de voxel (bits 8+).
// Direction : 0=+X,1=-X,2=+Y,3=-Y,4=+Z,5=-Z (axis=dir/2, back=dir%2, même convention
// que Chunk.cs Encode/Decode/AddGreedyFace).
AppendStructuredBuffer<uint4> ExposedFaces;

uint InnerWidth;
uint InnerHeight;
uint InnerDepth;
uint PaddedWidth;        // InnerWidth + 2
uint PaddedHeightStride; // stride utilisé pour l'indexation Y (>= InnerHeight)
int LoY;

uint VoxelAtPadded(int px, int py, int pz)
{
    uint idx = (uint)px + ((uint)py * PaddedWidth) + ((uint)pz * PaddedWidth * PaddedHeightStride);
    return Voxels[idx];
}

// Renvoie 0 (air) si py est hors [0, InnerHeight) : pas de bordure Y stockée, cf.
// World.IsVoxelSolid qui traite tout Y hors chunk comme de l'air.
uint NeighborType(int px, int py, int pz)
{
    if (py < 0 || py >= (int) InnerHeight)
    {
        return 0;
    }
    return VoxelAtPadded(px, py, pz);
}

[numthreads(4, 4, 4)]
void CullFaces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= InnerWidth || id.y >= InnerHeight || id.z >= InnerDepth)
    {
        return;
    }

    int px = (int) id.x + 1;
    int py = (int) id.y;
    int pz = (int) id.z + 1;

    uint self = VoxelAtPadded(px, py, pz);
    if (self == 0)
    {
        return; // air : ne peut posséder aucune face
    }

    int3 offsets[6] =
    {
        int3(1, 0, 0), int3(-1, 0, 0),
        int3(0, 1, 0), int3(0, -1, 0),
        int3(0, 0, 1), int3(0, 0, -1)
    };

    [unroll]
    for (int dir = 0; dir < 6; dir++)
    {
        int3 o = offsets[dir];
        uint neighbor = NeighborType(px + o.x, py + o.y, pz + o.z);
        if (neighbor == 0)
        {
            uint4 face;
            face.x = id.x;
            face.y = (uint) ((int) id.y + LoY);
            face.z = id.z;
            face.w = (uint) dir | (self << 8);
            ExposedFaces.Append(face);
        }
    }
}
