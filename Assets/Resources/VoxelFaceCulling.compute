#pragma kernel CullFaces

// Buffer aplati avec un padding de 1 voxel sur les 3 axes (X, Y et Z : depuis le passage aux
// chunks cubiques empilables verticalement, roadmap phase SVO sous-étape 2, un voisin peut
// exister sur Y aussi, pas seulement X/Z). PaddedIndex(px,py,pz) =
// px + py*PaddedWidth + pz*PaddedWidth*PaddedHeightStride. px=0 et px=PaddedWidth-1 sont la
// bordure gauche/droite (voisin de chunk, ou air si non chargé) ; idem pz pour Z, py=0 et
// py=PaddedHeightStride-1 pour Y. Les voxels intérieurs (dont ce chunk est propriétaire) sont à
// px=1..InnerWidth, py=1..InnerHeight, pz=1..InnerDepth.
StructuredBuffer<uint> Voxels;

// Une face exposée : (x, y, z, packed) en coordonnées locales du chunk (Y déjà "réel",
// pas décalé par LoY). packed = direction (0..5, bits 0-2) | type de voxel (bits 8+).
// Direction : 0=+X,1=-X,2=+Y,3=-Y,4=+Z,5=-Z (axis=dir/2, back=dir%2, même convention
// que Chunk.cs Encode/Decode/AddGreedyFace).
AppendStructuredBuffer<uint4> ExposedFaces;

uint InnerWidth;
uint InnerHeight;
uint InnerDepth;
uint PaddedWidth;        // InnerWidth + 2
uint PaddedHeightStride; // InnerHeight + 2 (padding réel sur Y désormais, voir en-tête)
int LoY;

uint VoxelAtPadded(int px, int py, int pz)
{
    uint idx = (uint)px + ((uint)py * PaddedWidth) + ((uint)pz * PaddedWidth * PaddedHeightStride);
    return Voxels[idx];
}

[numthreads(4, 4, 4)]
void CullFaces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= InnerWidth || id.y >= InnerHeight || id.z >= InnerDepth)
    {
        return;
    }

    int px = (int) id.x + 1;
    int py = (int) id.y + 1;
    int pz = (int) id.z + 1;

    uint self = VoxelAtPadded(px, py, pz);
    if (self == 0)
    {
        return; // air : ne peut posséder aucune face
    }

    int3 offsets[6] =
    {
        int3(1, 0, 0), int3(-1, 0, 0),
        int3(0, 1, 0), int3(0, -1, 0),
        int3(0, 0, 1), int3(0, 0, -1)
    };

    [unroll]
    for (int dir = 0; dir < 6; dir++)
    {
        int3 o = offsets[dir];
        uint neighbor = VoxelAtPadded(px + o.x, py + o.y, pz + o.z);
        if (neighbor == 0)
        {
            uint4 face;
            face.x = id.x;
            face.y = (uint) ((int) id.y + LoY);
            face.z = id.z;
            face.w = (uint) dir | (self << 8);
            ExposedFaces.Append(face);
        }
    }
}
